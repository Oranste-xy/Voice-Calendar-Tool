# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# 原来的付费项注释掉
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=

# ==== GLM LLM（免费）====
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ==== STT：Deepgram 语音转文字 ====
DEEPGRAM_API_KEY=

# ==== TTS：先用开源本地 GLM-TTS / 或免费 TTS ====

#mail
QQ_EMAIL=你的QQ号@qq.com
QQ_EMAIL_AUTH_CODE=你的授权码
# ── Daily (Transport，云端部署时使用) ──────────────────────────────
DAILY_API_KEY=
DAILY_ROOM_URL=       # Optional: leave empty to create a new room

# ── Cartesia (TTS，后续接入) ───────────────────────────────────────
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=  # Optional: defaults to "71a7ad14-091c-4e8e-a314-022ece01c121"

# ── OpenAI (备用) ──────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=