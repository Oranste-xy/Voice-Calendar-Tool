# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# ── GLM (LLM，当前使用) ────────────────────────────────────────────
GLM_API_KEY=edeb3797fc8244929b5a82d7913efb7c.o0eylLzUKomeBtHC
GLM_BASE_URL=https://open.bigmodel.ai/api/paas/v4/
GLM_MODEL=glm-4-flash # 可选，默认 glm-4-flash

# ── Daily (Transport，云端部署时使用) ──────────────────────────────
DAILY_API_KEY=
DAILY_ROOM_URL=       # Optional: leave empty to create a new room

# ── Cartesia (TTS，后续接入) ───────────────────────────────────────
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=  # Optional: defaults to "71a7ad14-091c-4e8e-a314-022ece01c121"

# ── Deepgram (STT，备用) ───────────────────────────────────────────
# DEEPGRAM_API_KEY=

# ── OpenAI (备用) ──────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=
